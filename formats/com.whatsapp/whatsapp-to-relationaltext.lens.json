{
  "$type": "org.relationaltext.lens",
  "id": "com.whatsapp.to.relationaltext.v1",
  "description": "Transform WhatsApp facets to RelationalText facets",
  "source": "com.whatsapp.facet",
  "target": "org.relationaltext.facet",
  "passthrough": "keep",
  "rules": [
    {
      "match": {
        "name": "bold"
      },
      "replace": {
        "name": "bold"
      }
    },
    {
      "match": {
        "name": "italic"
      },
      "replace": {
        "name": "italic"
      }
    },
    {
      "match": {
        "name": "strikethrough"
      },
      "replace": {
        "name": "strikethrough"
      }
    },
    {
      "match": {
        "name": "code"
      },
      "replace": {
        "name": "code"
      }
    },
    {
      "match": {
        "name": "paragraph"
      },
      "replace": {
        "name": "paragraph"
      }
    },
    {
      "match": {
        "name": "code-block"
      },
      "replace": {
        "name": "code-block"
      }
    },
    {
      "match": {
        "name": "blockquote-marker"
      },
      "replace": {
        "name": "blockquote-marker"
      }
    },
    {
      "match": {
        "name": "bullet-list-marker"
      },
      "replace": {
        "name": "bullet-list-marker"
      }
    },
    {
      "match": {
        "name": "ordered-list-marker"
      },
      "replace": {
        "name": "ordered-list-marker"
      }
    },
    {
      "match": {
        "name": "list-item-marker"
      },
      "replace": {
        "name": "list-item-marker"
      }
    },
    {
      "match": {
        "name": "list-item-text"
      },
      "replace": {
        "name": "list-item-text"
      }
    },
    {
      "match": {
        "name": "horizontal-rule"
      },
      "replace": {
        "name": "horizontal-rule"
      }
    },
    {
      "match": {
        "name": "unordered-list-item"
      },
      "replace": {
        "name": "unordered-list-item"
      }
    },
    {
      "match": {
        "name": "ordered-list-item"
      },
      "replace": {
        "name": "ordered-list-item"
      }
    }
  ]
}
