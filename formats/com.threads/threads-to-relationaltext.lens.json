{
  "$type": "org.relationaltext.lens",
  "id": "com.threads.to.relationaltext.v1",
  "description": "Transform Threads/Instagram facets to RelationalText facets",
  "source": "com.threads.facet",
  "target": "org.relationaltext.facet",
  "passthrough": "keep",
  "rules": [
    { "match": { "name": "bold" },     "replace": { "name": "bold" } },
    { "match": { "name": "italic" },   "replace": { "name": "italic" } },
    { "match": { "name": "mention" },  "replace": { "name": "mention" } },
    { "match": { "name": "hashtag" },  "replace": { "name": "hashtag" } },
    { "match": { "name": "link" },     "replace": { "name": "link", "renameAttrs": { "href": "url" } } },
    { "match": { "name": "paragraph" },"replace": { "name": "paragraph" } }
  ]
}
