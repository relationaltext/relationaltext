{
  "$type": "org.relationaltext.lens",
  "id": "org.bbcode.to.relationaltext.v1",
  "description": "Transform BBCode facets to RelationalText facets",
  "source": "org.bbcode.facet",
  "target": "org.relationaltext.facet",
  "passthrough": "keep",
  "rules": [
    {
      "match": {
        "name": "b"
      },
      "replace": {
        "name": "bold"
      }
    },
    {
      "match": {
        "name": "i"
      },
      "replace": {
        "name": "italic"
      }
    },
    {
      "match": {
        "name": "u"
      },
      "replace": {
        "name": "underline"
      }
    },
    {
      "match": {
        "name": "s"
      },
      "replace": {
        "name": "strikethrough"
      }
    },
    {
      "match": {
        "name": "code"
      },
      "replace": {
        "name": "code"
      }
    },
    {
      "match": {
        "name": "url"
      },
      "replace": {
        "name": "link",
        "renameAttrs": {
          "href": "url"
        }
      }
    },
    {
      "match": {
        "name": "img"
      },
      "replace": {
        "name": "image"
      }
    },
    {
      "match": {
        "name": "paragraph"
      },
      "replace": {
        "name": "paragraph"
      }
    },
    {
      "match": {
        "name": "code-block"
      },
      "replace": {
        "name": "code-block"
      }
    },
    {
      "match": {
        "name": "blockquote-marker"
      },
      "replace": {
        "name": "blockquote-marker"
      }
    },
    {
      "match": {
        "name": "bullet-list-marker"
      },
      "replace": {
        "name": "bullet-list-marker"
      }
    },
    {
      "match": {
        "name": "ordered-list-marker"
      },
      "replace": {
        "name": "ordered-list-marker"
      }
    },
    {
      "match": {
        "name": "list-item-marker"
      },
      "replace": {
        "name": "list-item-marker"
      }
    },
    {
      "match": {
        "name": "list-item-text"
      },
      "replace": {
        "name": "list-item-text"
      }
    },
    {
      "match": {
        "name": "unordered-list-item"
      },
      "replace": {
        "name": "unordered-list-item"
      }
    },
    {
      "match": {
        "name": "ordered-list-item"
      },
      "replace": {
        "name": "ordered-list-item"
      }
    }
  ]
}
