{
  "$type": "org.relationaltext.lens",
  "id": "io.lexical.to.relationaltext.v1",
  "description": "Transform Lexical facets to RelationalText facets",
  "source": "io.lexical.facet",
  "target": "org.relationaltext.facet",
  "rules": [
    {
      "match": {
        "name": "bold"
      },
      "replace": {
        "name": "bold"
      }
    },
    {
      "match": {
        "name": "italic"
      },
      "replace": {
        "name": "italic"
      }
    },
    {
      "match": {
        "name": "underline"
      },
      "replace": {
        "name": "underline"
      }
    },
    {
      "match": {
        "name": "strikethrough"
      },
      "replace": {
        "name": "strikethrough"
      }
    },
    {
      "match": {
        "name": "code"
      },
      "replace": {
        "name": "code"
      }
    },
    {
      "match": {
        "name": "superscript"
      },
      "replace": {
        "name": "superscript"
      }
    },
    {
      "match": {
        "name": "subscript"
      },
      "replace": {
        "name": "subscript"
      }
    },
    {
      "match": {
        "name": "link"
      },
      "replace": {
        "name": "link"
      }
    },
    {
      "match": {
        "name": "linebreak"
      },
      "replace": {
        "name": "line-break"
      }
    },
    {
      "match": {
        "name": "paragraph"
      },
      "replace": {
        "name": "paragraph"
      }
    },
    {
      "match": {
        "name": "heading"
      },
      "replace": {
        "name": "heading"
      }
    },
    {
      "match": {
        "name": "code-block"
      },
      "replace": {
        "name": "code-block"
      }
    },
    {
      "match": {
        "name": "list-item-text"
      },
      "replace": {
        "name": "list-item-text"
      }
    },
    {
      "match": {
        "name": "horizontalrule"
      },
      "replace": {
        "name": "horizontal-rule"
      }
    },
    {
      "match": {
        "name": "blockquote-marker"
      },
      "replace": {
        "name": "blockquote-marker"
      }
    },
    {
      "match": {
        "name": "bullet-list-marker"
      },
      "replace": {
        "name": "bullet-list-marker"
      }
    },
    {
      "match": {
        "name": "ordered-list-marker"
      },
      "replace": {
        "name": "ordered-list-marker"
      }
    },
    {
      "match": {
        "name": "list-item-marker"
      },
      "replace": {
        "name": "list-item-marker"
      }
    },
    {
      "match": {
        "name": "embed"
      },
      "replace": {
        "name": "embed"
      }
    },
    {
      "match": {
        "name": "table"
      },
      "replace": {
        "name": "table"
      }
    },
    {
      "match": {
        "name": "unordered-list-item"
      },
      "replace": {
        "name": "unordered-list-item"
      }
    },
    {
      "match": {
        "name": "ordered-list-item"
      },
      "replace": {
        "name": "ordered-list-item"
      }
    }
  ]
}
