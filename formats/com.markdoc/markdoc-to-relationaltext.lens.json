{
  "$type": "org.relationaltext.lens",
  "id": "com.markdoc.to.relationaltext.v1",
  "description": "Transform Markdoc facets to RelationalText facets",
  "source": "com.markdoc.facet",
  "target": "org.relationaltext.facet",
  "passthrough": "keep",
  "rules": [
    {
      "match": {
        "name": "strong"
      },
      "replace": {
        "name": "bold"
      }
    },
    {
      "match": {
        "name": "emphasis"
      },
      "replace": {
        "name": "italic"
      }
    },
    {
      "match": {
        "name": "strikethrough"
      },
      "replace": {
        "name": "strikethrough"
      }
    },
    {
      "match": {
        "name": "code-span"
      },
      "replace": {
        "name": "code"
      }
    },
    {
      "match": {
        "name": "link"
      },
      "replace": {
        "name": "link"
      }
    },
    {
      "match": {
        "name": "image"
      },
      "replace": {
        "name": "image"
      }
    },
    {
      "match": {
        "name": "line-break"
      },
      "replace": {
        "name": "line-break"
      }
    },
    {
      "match": {
        "name": "paragraph"
      },
      "replace": {
        "name": "paragraph"
      }
    },
    {
      "match": {
        "name": "heading"
      },
      "replace": {
        "name": "heading"
      }
    },
    {
      "match": {
        "name": "code-block"
      },
      "replace": {
        "name": "code-block"
      }
    },
    {
      "match": {
        "name": "blockquote-marker"
      },
      "replace": {
        "name": "blockquote-marker"
      }
    },
    {
      "match": {
        "name": "bullet-list-marker"
      },
      "replace": {
        "name": "bullet-list-marker"
      }
    },
    {
      "match": {
        "name": "ordered-list-marker"
      },
      "replace": {
        "name": "ordered-list-marker"
      }
    },
    {
      "match": {
        "name": "list-item-marker"
      },
      "replace": {
        "name": "list-item-marker"
      }
    },
    {
      "match": {
        "name": "list-item-text"
      },
      "replace": {
        "name": "list-item-text"
      }
    },
    {
      "match": {
        "name": "horizontal-rule"
      },
      "replace": {
        "name": "horizontal-rule"
      }
    },
    {
      "match": {
        "name": "tag"
      },
      "replace": {
        "name": "blockquote-marker"
      }
    },
    {
      "match": {
        "name": "variable"
      },
      "replace": {
        "name": "variable"
      }
    },
    {
      "match": {
        "name": "inline-tag"
      },
      "replace": {
        "name": "inline-tag"
      }
    },
    {
      "match": {
        "name": "frontmatter"
      },
      "replace": {
        "name": "frontmatter"
      }
    },
    {
      "match": {
        "name": "conditional"
      },
      "replace": {
        "name": "conditional"
      }
    },
    {
      "match": {
        "name": "unordered-list-item"
      },
      "replace": {
        "name": "unordered-list-item"
      }
    },
    {
      "match": {
        "name": "ordered-list-item"
      },
      "replace": {
        "name": "ordered-list-item"
      }
    }
  ]
}
